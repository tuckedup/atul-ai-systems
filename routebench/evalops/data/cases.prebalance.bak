{"candidate_output": "SELECT Fname, Sex \nFROM Student \nWHERE StuID IN (\n    SELECT StuID \n    FROM Has_Pet \n    GROUP BY StuID \n    HAVING COUNT(PetID) > 1\n);", "case_id": "sql-7bdc4144e7709f60", "context": "CREATE TABLE Student (\n       StuID    \tINTEGER PRIMARY KEY,\n       LName\t\tVARCHAR(12),\n       Fname\t\tVARCHAR(12),\n       Age\t\tINTEGER,\n       Sex\t\tVARCHAR(1),\n       Major\t\tINTEGER,\n       Advisor\t\tINTEGER,\n       city_code\tVARCHAR(3)\n)\nCREATE TABLE Has_Pet (\n       StuID\t\tINTEGER,\n       PetID\t\tINTEGER,\n       FOREIGN KEY(PetID) REFERENCES Pets(PetID),\n       FOREIGN KEY(StuID) REFERENCES Student(StuID)\n)\nCREATE TABLE Pets (\n       PetID\t\tINTEGER PRIMARY KEY,\n       PetType\t\tVARCHAR(20),\n       pet_age INTEGER,\n       weight REAL\n)", "difficulty": "medium", "generator_id": "gpt-4o-mini", "group_id": "spider-abb086f584ce", "meta": {"oracle_detail": "result sets match", "oracle_method": "sql:result_set"}, "origin": "real", "reference": "SELECT T1.fname ,  T1.sex FROM student AS T1 JOIN has_pet AS T2 ON T1.stuid  =  T2.stuid GROUP BY T1.stuid HAVING count(*)  >  1", "reference_provenance": "Spider human-written gold SQL", "rubric_id": "", "rubric_version": "", "schema_version": "1.0.0", "source": "Spider", "source_license": "CC-BY-SA-4.0", "task_class": "sql", "task_input": "Find the first name and gender of student who have more than one pet."}
{"candidate_output": "SELECT Name FROM stadium WHERE Stadium_ID NOT IN (\n    SELECT DISTINCT Stadium_ID FROM concert WHERE Year = '2014'\n);", "case_id": "sql-1410426f5a738b33", "context": "CREATE TABLE \"stadium\" (\n\"Stadium_ID\" int,\n\"Location\" text,\n\"Name\" text,\n\"Capacity\" int,\n\"Highest\" int,\n\"Lowest\" int,\n\"Average\" int,\nPRIMARY KEY (\"Stadium_ID\")\n)\nCREATE TABLE \"singer\" (\n\"Singer_ID\" int,\n\"Name\" text,\n\"Country\" text,\n\"Song_Name\" text,\n\"Song_release_year\" text,\n\"Age\" int,\n\"Is_male\" bool,\nPRIMARY KEY (\"Singer_ID\")\n)\nCREATE TABLE \"concert\" (\n\"concert_ID\" int,\n\"concert_Name\" text,\n\"Theme\" text,\n\"Stadium_ID\" text,\n\"Year\" text,\nPRIMARY KEY (\"concert_ID\"),\nFOREIGN KEY (\"Stadium_ID\") REFERENCES \"stadium\"(\"Stadium_ID\")\n)\nCREATE TABLE \"singer_in_concert\" (\n\"concert_ID\" int,\n\"Singer_ID\" text,\nPRIMARY KEY (\"concert_ID\",\"Singer_ID\"),\nFOREIGN KEY (\"concert_ID\") REFERENCES \"concert\"(\"concert_ID\"),\nFOREIGN KEY (\"Singer_ID\") REFERENCES \"singer\"(\"Singer_ID\")\n)", "difficulty": "medium", "generator_id": "gpt-4.1-nano", "group_id": "spider-574c4e5f949f", "meta": {"oracle_detail": "result sets match", "oracle_method": "sql:result_set"}, "origin": "real", "reference": "SELECT name FROM stadium EXCEPT SELECT T2.name FROM concert AS T1 JOIN stadium AS T2 ON T1.stadium_id  =  T2.stadium_id WHERE T1.year  =  2014", "reference_provenance": "Spider human-written gold SQL", "rubric_id": "", "rubric_version": "", "schema_version": "1.0.0", "source": "Spider", "source_license": "CC-BY-SA-4.0", "task_class": "sql", "task_input": "Show names for all stadiums except for stadiums having a concert in year 2014."}
{"candidate_output": "SELECT DISTINCT c.CountryId, c.CountryName \nFROM countries c \nLEFT JOIN car_makers cm ON c.CountryId = cm.Country \nLEFT JOIN model_list ml ON cm.Id = ml.Maker \nLEFT JOIN car_names cn ON ml.Model = cn.Model \nWHERE (SELECT COUNT(*) FROM car_makers WHERE Country = c.CountryId) > 3 \n   OR cn.Make = 'Fiat';", "case_id": "sql-95ff2b20ef9a3152", "context": "CREATE TABLE \"continents\" ( \n\t\"ContId\" INTEGER PRIMARY KEY, \n\t\"Continent\" TEXT \n)\nCREATE TABLE \"countries\" (\n\t\"CountryId\" INTEGER PRIMARY KEY, \n\t\"CountryName\" TEXT, \n\t\"Continent\" INTEGER,\n\tFOREIGN KEY (Continent) REFERENCES continents(ContId)\n)\nCREATE TABLE \"car_makers\" ( \n\t\"Id\" INTEGER PRIMARY KEY, \n\t\"Maker\" TEXT, \n\t\"FullName\" TEXT, \n\t\"Country\" TEXT,\n\tFOREIGN KEY (Country) REFERENCES countries(CountryId)\n)\nCREATE TABLE \"model_list\" ( \n\t\"ModelId\" INTEGER PRIMARY KEY, \n\t\"Maker\" INTEGER, \n\t\"Model\" TEXT UNIQUE,\n\tFOREIGN KEY (Maker) REFERENCES car_makers (Id)\n\n)\nCREATE TABLE \"car_names\" ( \n\t\"MakeId\" INTEGER PRIMARY KEY, \n\t\"Model\" TEXT, \n\t\"Make\" TEXT,\n\tFOREIGN KEY (Model) REFERENCES model_list (Model)\n)\nCREATE TABLE \"cars_data\" (\n\t\"Id\" INTEGER PRIMARY KEY, \n\t\"MPG\" TEXT, \n\t\"Cylinders\" INTEGER, \n\t\"Edispl\" REAL, \n\t\"Horsepower\" TEXT, \n\t\"Weight\" INTEGER, \n\t\"Accelerate\" REAL, \n\t\"Year\" INTEGER,\n\tFOREIGN KEY (Id) REFERENCES car_names (MakeId)\n)", "difficulty": "medium", "generator_id": "gpt-4o-mini", "group_id": "spider-493ee2b70a36", "meta": {"oracle_detail": "got 3 rows, gold 4 rows", "oracle_method": "sql:result_set"}, "origin": "real", "reference": "select t1.countryid ,  t1.countryname from countries as t1 join car_makers as t2 on t1.countryid  =  t2.country group by t1.countryid having count(*)  >  3 union select t1.countryid ,  t1.countryname from countries as t1 join car_makers as t2 on t1.countryid  =  t2.country join model_list as t3 on t2.id  =  t3.maker where t3.model  =  'fiat';", "reference_provenance": "Spider human-written gold SQL", "rubric_id": "", "rubric_version": "", "schema_version": "1.0.0", "source": "Spider", "source_license": "CC-BY-SA-4.0", "task_class": "sql", "task_input": "What are the ids and names of all countries that either have more than 3 car makers or produce fiat model ?"}
{"candidate_output": "SELECT Cylinders\nFROM cars_data\nWHERE Id = (\n    SELECT MakeId\n    FROM car_names\n    WHERE Model = 'volvo'\n    LIMIT 1\n)\nORDER BY Accelerate ASC\nLIMIT 1;", "case_id": "sql-bbaa3b6caf1fe6e2", "context": "CREATE TABLE \"continents\" ( \n\t\"ContId\" INTEGER PRIMARY KEY, \n\t\"Continent\" TEXT \n)\nCREATE TABLE \"countries\" (\n\t\"CountryId\" INTEGER PRIMARY KEY, \n\t\"CountryName\" TEXT, \n\t\"Continent\" INTEGER,\n\tFOREIGN KEY (Continent) REFERENCES continents(ContId)\n)\nCREATE TABLE \"car_makers\" ( \n\t\"Id\" INTEGER PRIMARY KEY, \n\t\"Maker\" TEXT, \n\t\"FullName\" TEXT, \n\t\"Country\" TEXT,\n\tFOREIGN KEY (Country) REFERENCES countries(CountryId)\n)\nCREATE TABLE \"model_list\" ( \n\t\"ModelId\" INTEGER PRIMARY KEY, \n\t\"Maker\" INTEGER, \n\t\"Model\" TEXT UNIQUE,\n\tFOREIGN KEY (Maker) REFERENCES car_makers (Id)\n\n)\nCREATE TABLE \"car_names\" ( \n\t\"MakeId\" INTEGER PRIMARY KEY, \n\t\"Model\" TEXT, \n\t\"Make\" TEXT,\n\tFOREIGN KEY (Model) REFERENCES model_list (Model)\n)\nCREATE TABLE \"cars_data\" (\n\t\"Id\" INTEGER PRIMARY KEY, \n\t\"MPG\" TEXT, \n\t\"Cylinders\" INTEGER, \n\t\"Edispl\" REAL, \n\t\"Horsepower\" TEXT, \n\t\"Weight\" INTEGER, \n\t\"Accelerate\" REAL, \n\t\"Year\" INTEGER,\n\tFOREIGN KEY (Id) REFERENCES car_names (MakeId)\n)", "difficulty": "medium", "generator_id": "gpt-4.1-nano", "group_id": "spider-a855e8f1d168", "meta": {"oracle_detail": "got 1 rows, gold 1 rows", "oracle_method": "sql:result_set"}, "origin": "real", "reference": "SELECT T1.cylinders FROM CARS_DATA AS T1 JOIN CAR_NAMES AS T2 ON T1.Id  =  T2.MakeId WHERE T2.Model  =  'volvo' ORDER BY T1.accelerate ASC LIMIT 1;", "reference_provenance": "Spider human-written gold SQL", "rubric_id": "", "rubric_version": "", "schema_version": "1.0.0", "source": "Spider", "source_license": "CC-BY-SA-4.0", "task_class": "sql", "task_input": "For model volvo, how many cylinders does the car with the least accelerate have?"}
{"candidate_output": "SELECT COUNT(*) \nFROM Has_Pet HP \nJOIN Student S ON HP.StuID = S.StuID \nJOIN Pets P ON HP.PetID = P.PetID \nWHERE P.PetType = 'Dog' AND S.Sex = 'F';", "case_id": "sql-2669552d2fe17050", "context": "CREATE TABLE Student (\n       StuID    \tINTEGER PRIMARY KEY,\n       LName\t\tVARCHAR(12),\n       Fname\t\tVARCHAR(12),\n       Age\t\tINTEGER,\n       Sex\t\tVARCHAR(1),\n       Major\t\tINTEGER,\n       Advisor\t\tINTEGER,\n       city_code\tVARCHAR(3)\n)\nCREATE TABLE Has_Pet (\n       StuID\t\tINTEGER,\n       PetID\t\tINTEGER,\n       FOREIGN KEY(PetID) REFERENCES Pets(PetID),\n       FOREIGN KEY(StuID) REFERENCES Student(StuID)\n)\nCREATE TABLE Pets (\n       PetID\t\tINTEGER PRIMARY KEY,\n       PetType\t\tVARCHAR(20),\n       pet_age INTEGER,\n       weight REAL\n)", "difficulty": "medium", "generator_id": "gpt-4o-mini", "group_id": "spider-6c0f467bb874", "meta": {"oracle_detail": "got 1 rows, gold 1 rows", "oracle_method": "sql:result_set"}, "origin": "real", "reference": "SELECT count(*) FROM student AS T1 JOIN has_pet AS T2 ON T1.stuid  =  T2.stuid JOIN pets AS T3 ON T2.petid  =  T3.petid WHERE T1.sex  =  'F' AND T3.pettype  =  'dog'", "reference_provenance": "Spider human-written gold SQL", "rubric_id": "", "rubric_version": "", "schema_version": "1.0.0", "source": "Spider", "source_license": "CC-BY-SA-4.0", "task_class": "sql", "task_input": "How many dog pets are raised by female students?"}
