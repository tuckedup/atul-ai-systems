{"title":"RouteBench","uid":"routebench","schemaVersion":39,"panels":[{"id":1,"title":"TTFT","type":"timeseries","targets":[{"expr":"histogram_quantile(0.95, rate(routebench_ttft_seconds_bucket[5m]))"}]},{"id":2,"title":"TPOT","type":"timeseries","targets":[{"expr":"histogram_quantile(0.95, rate(routebench_tpot_seconds_bucket[5m]))"}]},{"id":3,"title":"p50 / p95 / p99","type":"timeseries","targets":[{"expr":"histogram_quantile(0.50, rate(routebench_request_latency_seconds_bucket[5m]))"},{"expr":"histogram_quantile(0.95, rate(routebench_request_latency_seconds_bucket[5m]))"},{"expr":"histogram_quantile(0.99, rate(routebench_request_latency_seconds_bucket[5m]))"}]},{"id":4,"title":"Tokens/sec","type":"timeseries","targets":[{"expr":"rate(routebench_tokens_total[5m])"}]},{"id":5,"title":"Throughput","type":"timeseries","targets":[{"expr":"rate(routebench_requests_total[5m])"}]},{"id":6,"title":"GPU utilization","type":"timeseries","targets":[{"expr":"DCGM_FI_DEV_GPU_UTIL"}]},{"id":7,"title":"Cache hit","type":"timeseries","targets":[{"expr":"rate(routebench_cache_hits_total[5m]) / rate(routebench_cache_requests_total[5m])"}]},{"id":8,"title":"Cost/request","type":"timeseries","targets":[{"expr":"rate(routebench_cost_usd_total[5m]) / rate(routebench_requests_total[5m])"}]},{"id":9,"title":"Error rate","type":"timeseries","targets":[{"expr":"rate(routebench_requests_total{status=\"error\"}[5m]) / rate(routebench_requests_total[5m])"}]}]}

